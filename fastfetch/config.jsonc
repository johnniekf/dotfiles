{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "right": 2
    },
    "color": {
      "1": "\u001b[38;2;231;130;132m",
      "2": "\u001b[38;2;239;159;118m",
      "3": "\u001b[38;2;229;200;144m",
      "4": "\u001b[38;2;166;209;137m",
      "5": "\u001b[38;2;153;209;219m",
      "6": "\u001b[38;2;133;193;220m",
      "7": "\u001b[38;2;140;170;238m",
      "8": "\u001b[38;2;186;187;241m",
      "9": "\u001b[38;2;202;158;230m"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "yellow",
      "format": "{1}"
    },
    {
      "type": "memory",
      "key": " RAM",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": " Disk",
      "keyColor": "yellow",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    "break",
    {
      "type": "uptime",
      "key": " Uptime",
      "keyColor": "green"
    },
    {
      "type": "localip",
      "key": " IP",
      "keyColor": "green",
      "showIpv6": false,
      "compact": true
    }
  ]
}
